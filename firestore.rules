// Firestore-Sicherheitsregeln für Space Wheel
// Diese Datei ist die Referenzfassung. Änderungen müssen zusätzlich in der
// Firebase Console unter Firestore → Regeln eingefügt und veröffentlicht werden.
//
// Hinweis zur Schreibweise: Die Prüfungen arbeiten mit Mengenoperationen
// (hasAll / removeAll / size) statt mit exaktem Listenvergleich. Exakte
// Vergleiche sind in Verbindung mit arrayUnion/arrayRemove empfindlich
// gegenüber Reihenfolge und wirkungslosen Schreibvorgängen.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;

      // Eigenes Dokument: create, update und delete erlaubt
      allow write: if request.auth != null && request.auth.uid == uid;

      // Freundschaftsanfrage senden: bestehende Einträge müssen erhalten
      // bleiben, und neu dazukommen darf ausschließlich die eigene uid —
      // höchstens ein Eintrag pro Schreibvorgang.
      allow update: if request.auth != null && request.auth.uid != uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingRequests']) &&
                       request.resource.data.pendingRequests.hasAll(resource.data.get('pendingRequests', [])) &&
                       request.resource.data.pendingRequests
                         .removeAll(resource.data.get('pendingRequests', []))
                         .hasOnly([request.auth.uid]) &&
                       request.resource.data.pendingRequests.size() <=
                         resource.data.get('pendingRequests', []).size() + 1;

      // Anfrage annehmen: nur die eigene uid darf zu friends dazukommen, und
      // nur wenn von dieser Person tatsächlich eine Anfrage bei mir vorliegt.
      allow update: if request.auth != null && request.auth.uid != uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
                       request.resource.data.friends.hasAll(resource.data.get('friends', [])) &&
                       request.resource.data.friends
                         .removeAll(resource.data.get('friends', []))
                         .hasOnly([request.auth.uid]) &&
                       request.resource.data.friends.size() <=
                         resource.data.get('friends', []).size() + 1 &&
                       uid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('pendingRequests', []);

      // Konto löschen: sich selbst — und nur sich selbst — aus fremden
      // Freundeslisten austragen. Es darf nichts hinzugefügt und niemand
      // anderes entfernt werden.
      allow update: if request.auth != null && request.auth.uid != uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
                       resource.data.get('friends', []).hasAll(request.resource.data.friends) &&
                       !(request.auth.uid in request.resource.data.friends) &&
                       resource.data.get('friends', [])
                         .removeAll(request.resource.data.friends)
                         .hasOnly([request.auth.uid]);
    }

    // Namensreservierung: nur im Moment der Registrierung (solange noch kein
    // eigenes users-Dokument existiert) und nur auf die eigene uid.
    // Bestehende Einträge sind unveränderlich, da kein update erlaubt ist.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasOnly(['uid']) &&
                       request.resource.data.uid == request.auth.uid &&
                       !exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /friendCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasOnly(['uid']) &&
                       request.resource.data.uid == request.auth.uid &&
                       !exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
